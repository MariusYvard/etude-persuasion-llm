# Copier vers .env et renseigner. .env est dans .gitignore, ne jamais le commiter.

# =====================================================================
# GÉNÉRATEURS, les cinq modèles évalués
#
# Cinq lignées d'alignement, trois provenances : États-Unis (2), France (1),
# Chine (2). Deux familles chinoises et non une : le contraste 5 gagne ainsi
# une bande de référence interne, l'accord entre les deux modèles chinois
# devenant lui-même un test. Motif en section 3.6.2.
# =====================================================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Alibaba Model Studio, point d'accès international, compatible OpenAI.
# Clé à créer sur https://modelstudio.console.alibabacloud.com
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Identifiants de version, à figer avant la première génération.
# Les résultats sont attachés à ces versions et la publication doit les citer.
GEN_MODEL_ANTHROPIC=claude-opus-5
GEN_MODEL_OPENAI=gpt-5.6-terra
GEN_MODEL_MISTRAL=mistral-medium-3-5
GEN_MODEL_ALIBABA=qwen3.5-plus

# Cinquième générateur, servi par NVIDIA NIM et non par son éditeur, faute
# d'un accès direct. Aucune clé supplémentaire, il réutilise NVIDIA_API_KEY.
# Asymétrie d'hébergement déclarée au protocole : quantification et prompt
# système de la couche de service ne sont pas documentés.
#
# Kimi et GLM ont été essayés d'abord. Tous deux figurent au catalogue NVIDIA
# et aucun des deux n'est invocable par ce compte : 404 pour Kimi, délai
# dépassé même à 150 s pour GLM. MiniMax est le seul modèle chinois du
# catalogue qui réponde réellement, DeepSeek occupant déjà le siège J3.
GEN_MODEL_MINIMAX=minimaxai/minimax-m3

# DeepSeek n'est pas éligible au poste de générateur : sa lignée occupe déjà
# le siège J3 du panel de notation. StepFun non plus, il construit l'étage
# d'échelle du corpus. Le préflight refuse ces collisions.

# Paramètres d'échantillonnage, identiques pour les cinq générateurs.
# Vérifier qu'ils sont ACCEPTÉS et non ignorés en silence :
#   python harnais/preflight.py --echo
# Sans cela, effet de modèle et effet de décodage sont confondus.
# temperature 1.0 : les 3 tirages par condition n'ont de sens qu'avec de la variance.
# top_p 1.0 : une troncature nucleus couperait la queue de distribution, or c'est
#             là que vivent les sorties inhabituelles que l'étude cherche à détecter.
GEN_TEMPERATURE=1.0
GEN_TOP_P=1.0

# Effort de raisonnement, troisième confondant. Identique pour les trois.
# minimal : l'étude porte sur la production sous consigne, pas après délibération.
# Choix déclaré comme discutable, avec un contrôle de robustesse préenregistré.
GEN_REASONING_EFFORT=minimal

# =====================================================================
# NVIDIA NIM, hébergeur de modèles à poids ouverts
# Sert à trois rôles distincts : le panel de notation, les trois constructeurs
# du corpus, et depuis le 30 juillet le cinquième générateur. Compatible OpenAI, base ci-dessous.
# Palier gratuit : environ 40 requêtes par minute, pas de carte bancaire.
# =====================================================================

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Juges, panel mixte à provenance équilibrée ---
#
# Trois juges par message :
#   J1  un générateur non émetteur, tiré parmi les QUATRE autres. Jamais un
#       sous-ensemble : réserver Anthropic à la génération créerait une
#       asymétrie de jury entre générateurs, donc un confondant avec le
#       facteur générateur lui-même.
#       Charge invariante : le total J1 vaut 8 400 x G et se répartit sur G
#       générateurs, soit 8 400 chacun. Ajouter un générateur ne coûte rien
#       en notation aux autres.
#   J2  poids ouverts, provenance États-Unis
#   J3  poids ouverts, provenance Chine
#
# Motif de l'équilibre de provenance : H3 mesure un biais culturel. Un panel
# culturellement homogène confondrait ce qui est mesuré avec la position d'où
# l'on mesure. Un vivier uniquement chinois, vers lequel penchait la sélection
# précédente, aurait ses propres angles morts sur l'Amérique latine ou la Grèce.
JUDGE_MODEL_US=meta/llama-3.3-70b-instruct
JUDGE_MODEL_CN=deepseek-ai/deepseek-v4-pro

# Vivier de remplacement, mobilisable si J2 ou J3 échoue le seuil d'accord.
# Toute substitution préserve la provenance : un remplaçant chinois ne peut
# se substituer qu'à J3.
JUDGE_SPARE_US_1=nvidia/nemotron-3-super-120b-a12b
JUDGE_SPARE_US_2=nvidia/nemotron-3-ultra-550b-a55b

# Vivier chinois : vide en pratique. GLM est conservé pour mémoire mais ne
# répond pas à l'inference, Kimi renvoie un 404, MiniMax est passé générateur.
# Si J3 échoue le seuil d'accord, aucun remplaçant de même provenance n'est
# disponible et la clause d'escalade de la section 3.6 s'applique.
JUDGE_SPARE_CN_1=z-ai/glm-5.2

# --- Modèles constructeurs du corpus ---
# Double contrainte de disjonction, la seconde étant facile à oublier :
#   1. disjoints des cinq générateurs
#   2. disjoints des juges, sinon un juge validerait le réalisme d'un texte
#      écrit par sa propre lignée, ce qui annule le contrôle d'acceptation
#
# Trois constructeurs et non cinq. Yi, Jamba et Palmyra figurent au catalogue
# NVIDIA mais renvoient tous un 404 à l'inference sur ce compte, comme DBRX,
# Zamba, Phi et les variantes Gemma testées en remplacement. Le vivier réel
# est celui-ci. Le critère d'acceptation du corpus reste la discrimination
# en aveugle, pas le nombre de familles.
BUILDER_MODEL_1=google/gemma-4-31b-it
BUILDER_MODEL_2=stepfun-ai/step-3.7-flash
BUILDER_MODEL_3=poolside/laguna-xs-2.1

# =====================================================================
# Ollama local, hors protocole
# Conservé pour des essais rapides uniquement. Le panel de production
# ne tourne pas ici : 126 000 notations ne passent pas sur cette machine, et
# faire tourner le pilote sur un autre juge que la production invaliderait
# la sélection de configuration que le pilote est censé opérer.
# =====================================================================

OLLAMA_ENDPOINT=http://localhost:11434
