# Copier vers .env et renseigner. .env est dans .gitignore, ne jamais le commiter.

# =====================================================================
# GÉNÉRATEURS, les trois modèles évalués
# =====================================================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Identifiants de version, à figer avant la première génération.
# Les résultats sont attachés à ces versions et la publication doit les citer.
GEN_MODEL_ANTHROPIC=claude-opus-5
GEN_MODEL_OPENAI=gpt-5.6-terra
GEN_MODEL_MISTRAL=mistral-medium-3-5

# Paramètres d'échantillonnage, identiques pour les trois générateurs.
# Sans cela, effet de modèle et effet de décodage sont confondus.
# temperature 1.0 : les 3 tirages par condition n'ont de sens qu'avec de la variance.
# top_p 1.0 : une troncature nucleus couperait la queue de distribution, or c'est
#             là que vivent les sorties inhabituelles que l'étude cherche à détecter.
GEN_TEMPERATURE=1.0
GEN_TOP_P=1.0

# Effort de raisonnement, troisième confondant. Identique pour les trois.
# minimal : l'étude porte sur la production sous consigne, pas après délibération.
# Choix déclaré comme discutable, avec un contrôle de robustesse préenregistré.
GEN_REASONING_EFFORT=minimal

# =====================================================================
# NVIDIA NIM, hébergeur de modèles à poids ouverts
# Sert à deux rôles distincts : famille D pour la notation, et les trois
# modèles constructeurs du corpus. Compatible OpenAI, base ci-dessous.
# Palier gratuit : environ 40 requêtes par minute, pas de carte bancaire.
# =====================================================================

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Juges ---
# Toute la notation passe par NVIDIA, aucun générateur ne juge. Conséquence :
# plus aucune comptabilité d'exclusion à tenir, et la notation ne coûte rien.
# Volume : 75 600 notations. À 40 RPM, environ 31 heures, donc un week-end.
#
# Six candidats sont soumis au pilote, TROIS sont retenus pour la production.
# La sélection se fait sur l'accord avec le codage humain, stratifié par langue.
# Le corpus couvre 14 langues et un juge peut tenir en anglais puis céder sur
# le registre japonais ou l'alternance codique indonésienne.
JUDGE_MODEL_1=deepseek-ai/deepseek-v4-pro
JUDGE_MODEL_2=moonshotai/kimi-k2.6
JUDGE_MODEL_3=z-ai/glm-5.2
JUDGE_MODEL_4=meta/llama-3.3-70b-instruct
JUDGE_MODEL_5=nvidia/nemotron-3-super-120b-a12b
JUDGE_MODEL_6=minimaxai/minimax-m3

# --- Modèles constructeurs du corpus ---
# Double contrainte de disjonction, la seconde étant facile à oublier :
#   1. disjoints des trois générateurs
#   2. disjoints des juges, sinon un juge validerait le réalisme d'un texte
#      écrit par sa propre lignée, ce qui annule le contrôle d'acceptation
#
# Cinq constructeurs plutôt que trois : plus de familles, plus de dilution de
# la signature stylistique, ce qui sert directement le contrôle anti-gabarit.
BUILDER_MODEL_1=google/gemma-4-31b-it
BUILDER_MODEL_2=01-ai/yi-large
BUILDER_MODEL_3=ai21labs/jamba-1.5-large-instruct
BUILDER_MODEL_4=writer/palmyra-creative-122b
BUILDER_MODEL_5=stepfun-ai/step-3.7-flash

# =====================================================================
# Ollama local, hors protocole
# Conservé pour des essais rapides uniquement. La famille D de production
# ne tourne pas ici : 25 200 notations ne passent pas sur cette machine, et
# faire tourner le pilote sur un autre juge que la production invaliderait
# la sélection de configuration que le pilote est censé opérer.
# =====================================================================

OLLAMA_ENDPOINT=http://localhost:11434
